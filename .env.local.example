# Copy this file to .env.local and fill in real values.
# Get these from: Supabase Dashboard -> your project -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your anon public key>

# Server-only — never expose to the browser. Reveal via "Reveal" button on the same page.
SUPABASE_SERVICE_ROLE_KEY=<your service role key>

# Transactional email (invites + password resets) — https://resend.com
# RESEND_FROM must use a domain verified at resend.com/domains. Until one is
# verified, Resend's shared onboarding@resend.dev sender only delivers to the
# account owner's own address and rejects everyone else with a 403.
RESEND_API_KEY=<your resend api key>
RESEND_FROM="Prestige Legacy <noreply@yourdomain.com>"

# Error monitoring — https://malvisse.sentry.io/projects/prestigelegacycrm/
# Get this from: Sentry -> prestigelegacycrm project -> Settings -> Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=<your sentry dsn>
