# Copy this file to .env.local and fill in real values.
# Get these from: Supabase Dashboard -> your project -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your anon public key>

# Server-only — never expose to the browser. Reveal via "Reveal" button on the same page.
SUPABASE_SERVICE_ROLE_KEY=<your service role key>

# Transactional email (invites + password resets) — https://resend.com
# RESEND_FROM must use a domain verified at resend.com/domains. Until one is
# verified, Resend's shared onboarding@resend.dev sender only delivers to the
# account owner's own address and rejects everyone else with a 403.
RESEND_API_KEY=<your resend api key>
RESEND_FROM="Prestige Legacy <noreply@yourdomain.com>"

# Error monitoring — https://malvisse.sentry.io/projects/prestigelegacycrm/
# Get this from: Sentry -> prestigelegacycrm project -> Settings -> Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=<your sentry dsn>

# Server-only — lets `next build` upload source maps to Sentry so stack traces
# show real file/line/function names instead of minified code. Without it,
# errors still get captured, just harder to pinpoint.
# Get this from: Sentry -> org Settings -> Developer Settings -> Auth Tokens
# -> New Token, scope "project:releases". Also set this in the hosting
# platform's build environment (e.g. Vercel project settings), not just here.
SENTRY_AUTH_TOKEN=<your sentry auth token>
